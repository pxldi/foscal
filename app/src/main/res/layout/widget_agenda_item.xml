<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- Fixed width, and kept even on the second event of a day where its labels are blank, so
         every colour bar in the list lines up in one column. -->
    <LinearLayout
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/widget_item_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_subtitle"
            android:fontFamily="@font/hanken_grotesque_variable"
            android:textFontWeight="600"
            android:textSize="11sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_item_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_title"
            android:fontFamily="@font/bricolage_grotesque_variable"
            android:textFontWeight="700"
            android:textSize="19sp"
            android:singleLine="true" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_item_color"
        android:layout_width="3dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/widget_color_bar"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_title"
            android:textSize="15sp"
            android:fontFamily="@font/hanken_grotesque_variable"
            android:textFontWeight="700"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_item_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_subtitle"
            android:textSize="13sp"
            android:fontFamily="@font/hanken_grotesque_variable"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
