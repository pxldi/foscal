<?xml version="1.0" encoding="utf-8"?>
<!--
  Unified Calendarium mark: a white calendar glyph (rounded body, two top tabs, header divider,
  two dots) centred in the adaptive-icon safe zone. Mirrors the onboarding hero glyph so the
  launcher icon and the in-app mark are the same drawing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Calendar body (rounded rect outline) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M42,37.2 H66 a8.4,8.4 0 0 1 8.4,8.4 V64.8 a8.4,8.4 0 0 1 -8.4,8.4 H42 a8.4,8.4 0 0 1 -8.4,-8.4 V45.6 a8.4,8.4 0 0 1 8.4,-8.4 Z" />
    <!-- Header divider -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:pathData="M33.6,48 H74.4" />
    <!-- Top tabs -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M44.4,33.6 V40.8 M63.6,33.6 V40.8" />
    <!-- Two dots -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46.8,55.4 a3.4,3.4 0 1 0 0.01,0 M61.2,55.4 a3.4,3.4 0 1 0 0.01,0" />
</vector>
