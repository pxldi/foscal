<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the reminder fixes ask about this app directly instead of dropping the user
         into a list of every app on the phone. Restricted to apps whose core function is
         alarms and reminders, which is the same basis as USE_EXACT_ALARM above. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      INTERNET is used ONLY by the opt-in "Pick on map" location picker (OpenStreetMap tiles +
      Nominatim reverse-geocoding). No other feature touches the network; the app is otherwise
      fully offline. See AGENTS.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional: only used to center the opt-in map picker on the user's current area. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.alarm" android:required="false" />

    <!--
      Package visibility. From Android 11 an app cannot see another package unless it is declared
      here, and both things below fail *silently* without it — getPackageInfo throws
      NameNotFoundException and resolveActivity returns null, exactly as if the app were absent.

      - DAVx5, so onboarding can tell "install it" from "open it".
      - The vendor autostart / app-manager screens the reminder diagnostics panel offers when the
        device has one. See VendorSettings, which holds the matching component names.
    -->
    <queries>
        <package android:name="at.bitfire.davdroid" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.asus.mobilemanager" />
        <package android:name="com.letv.android.letvsafe" />
        <package android:name="com.htc.pitroad" />
    </queries>

    <application
        android:name=".FoscalApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Foscal"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Foscal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              How a launcher finds "the calendar app". Niagara, Lawnchair and the rest resolve
              their calendar slot with ACTION_MAIN + CATEGORY_APP_CALENDAR, and an app that does
              not declare it simply cannot be chosen, however it is named.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>

            <!--
              "Show me this day" and "show me this event". Both arrive on the CalendarContract
              authority and are told apart by the first path segment, so they share a filter.
              Senders usually leave the MIME type off and let the system derive it from the
              provider, which is why the URI is matched directly rather than by type alone.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:host="com.android.calendar"
                    android:pathPrefix="/time" />
                <data
                    android:scheme="content"
                    android:host="com.android.calendar"
                    android:pathPrefix="/events" />
            </intent-filter>

            <!-- The same two, for senders that do set a type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>

            <!--
              "Add to calendar" from a browser, a mail app or a share sheet. ACTION_EDIT is here
              as well because that is what a good many senders actually use for a new event.
            -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/event" />
            </intent-filter>

            <!-- An .ics file opened from a file manager, a download, or a mail attachment. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
            </intent-filter>

            <!--
              The same file when nobody could name its type. Providers routinely report
              application/octet-stream for anything they do not recognise, so without this the
              app is missing from "Open with" for exactly the files it can read. Type and path
              are both required, not either — claiming every octet-stream would put Foscal in
              the "Open with" list for every unknown file on the phone. The repeated patterns
              cover names with dots in them, which pathPattern does not handle on its own.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.ics" />
                <data android:pathPattern=".*\\..*\\.ics" />
                <data android:pathPattern=".*\\..*\\..*\\.ics" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notifications.ReminderAlarmReceiver"
            android:exported="false" />

        <!--
          Every action here is a protected broadcast the system alone can send, so exporting the
          receiver does not let another app trigger it. See SystemEventReceiver for why each one
          invalidates the armed alarms.
        -->
        <receiver
            android:name=".notifications.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          WorkManager's default initializer is removed so FoscalApp can supply a Configuration with
          Hilt's worker factory; without this the on-demand configuration is ignored and
          ReminderSyncWorker fails to instantiate at runtime.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <receiver
            android:name=".widget.AgendaWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agenda_widget_info" />
        </receiver>

        <service
            android:name=".widget.AgendaWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

    </application>

</manifest>
